# Local build: upstream mautrix-imessage 300ba6d + ignore-chats patch (ignorechats.go,
# hooks in imessage.go/portal.go), on top of the exact upstream image we ran (alpine 3.19).
# 2026-11-19: ignore list fails closed (security review); its tests run during the build, as a
# non-root user so the "unreadable file" case is exercised.
FROM golang:1.23-alpine3.19 AS build
RUN apk add --no-cache gcc g++ musl-dev olm-dev
WORKDIR /src
COPY . .
RUN go mod download
RUN chmod -R a+rX /src && su nobody -s /bin/sh -c 'export HOME=/tmp GOCACHE=/tmp/gocache GOPATH=/go PATH=/usr/local/go/bin:/usr/bin:/bin GOFLAGS=-mod=mod CGO_ENABLED=1; cd /src && go test -run TestIgnoreChats -count=1 -v .'
RUN CGO_ENABLED=1 go build -trimpath \
    -ldflags "-X main.Commit=300ba6d0-home-ignorechats2 -X 'main.BuildTime=Nov 19 2026'" \
    -o /out/mautrix-imessage .
FROM dock.mau.dev/mautrix/imessage@sha256:ac5014db265579cef8678de0b73c7e8fe2d9daf2f2dc3756e603ee305c069bb0
RUN apk add --no-cache olm libstdc++
COPY --from=build /out/mautrix-imessage /usr/bin/mautrix-imessage
